rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function coursePath(courseId) {
      return /databases/$(database)/documents/cursos/$(courseId);
    }

    function courseExists(courseId) {
      return exists(coursePath(courseId));
    }

    function courseDoc(courseId) {
      return get(coursePath(courseId));
    }

    function isCourseTeacher(courseId) {
      return signedIn()
        && courseExists(courseId)
        && courseDoc(courseId).data.teacherId == request.auth.uid;
    }

    function isCourseStudent(courseId) {
      return signedIn()
        && courseExists(courseId)
        && (
          request.auth.uid in courseDoc(courseId).data.enrolledStudents
          || (
            studentDocExists(request.auth.uid)
            && courseId in get(studentPath(request.auth.uid)).data.courses
          )
        );
    }

    function canAccessCourse(courseId) {
      return isCourseTeacher(courseId)
        || isCourseStudent(courseId)
        || canManageInstitutionCourse(courseId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function studentPath(uid) {
      return /databases/$(database)/documents/estudiantes/$(uid);
    }

    function userDocExists(uid) {
      return exists(userPath(uid));
    }

    function studentDocExists(uid) {
      return exists(studentPath(uid));
    }

    function userIsTeacher(uid) {
      return userDocExists(uid) && get(userPath(uid)).data.role == 'docente';
    }

    function userHasInstitutionPrivileges(uid) {
      return (
        userDocExists(uid)
        && (
          get(userPath(uid)).data.role == 'institucion'
          || get(userPath(uid)).data.requestedRole == 'institucion'
          || get(userPath(uid)).data.institutionRole in ['owner', 'coordinator']
        )
      )
      || (
        studentDocExists(uid)
        && (
          get(studentPath(uid)).data.role == 'institucion'
          || get(studentPath(uid)).data.requestedRole == 'institucion'
          || get(studentPath(uid)).data.institutionRole in ['owner', 'coordinator']
        )
      );
    }

    function userIsInstitution(uid) {
      return userHasInstitutionPrivileges(uid);
    }

    function currentInstitutionId() {
      return userDocExists(request.auth.uid)
        && get(userPath(request.auth.uid)).data.institutionId is string
          ? get(userPath(request.auth.uid)).data.institutionId
          : (
              studentDocExists(request.auth.uid)
              && get(studentPath(request.auth.uid)).data.institutionId is string
                ? get(studentPath(request.auth.uid)).data.institutionId
                : (
                    userHasInstitutionPrivileges(request.auth.uid)
                      ? request.auth.uid
                      : ""
                  )
            );
    }

    function canManageInstitutionById(institutionId) {
      return signedIn()
        && institutionId is string
        && institutionId.size() > 0
        && (
          isOwnerAdminEmail()
          || (
            userHasInstitutionPrivileges(request.auth.uid)
            && currentInstitutionId() == institutionId
          )
        );
    }

    function userBelongsToInstitution(uid, institutionId) {
      return institutionId is string
        && institutionId.size() > 0
        && (
          (userDocExists(uid) && get(userPath(uid)).data.institutionId == institutionId)
          || (studentDocExists(uid) && get(studentPath(uid)).data.institutionId == institutionId)
        );
    }

    function teacherBelongsToInstitution(uid, institutionId) {
      return userBelongsToInstitution(uid, institutionId)
        && (
          (userDocExists(uid) && get(userPath(uid)).data.role == 'docente')
          || (studentDocExists(uid) && get(studentPath(uid)).data.role == 'docente')
          || (userDocExists(uid) && get(userPath(uid)).data.requestedRole == 'docente')
          || (studentDocExists(uid) && get(studentPath(uid)).data.requestedRole == 'docente')
        );
    }

    function canManageInstitutionCourse(courseId) {
      return courseExists(courseId)
        && hasInstitutionId(courseDoc(courseId).data)
        && canManageInstitutionById(courseDoc(courseId).data.institutionId);
    }

    function targetUserIsStudent(uid) {
      return userDocExists(uid) && get(userPath(uid)).data.role == 'estudiante';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCurrentUserTeacher() {
      return signedIn() && userIsTeacher(request.auth.uid);
    }

    function isOwnerAdminEmail() {
      return signedIn()
        && (
          (
            request.auth.token.email is string
            && request.auth.token.email.matches('(?i)^rcroman20@gmail\\.com$')
          )
          || (
            userDocExists(request.auth.uid)
            && get(userPath(request.auth.uid)).data.email is string
            && get(userPath(request.auth.uid)).data.email.matches('(?i)^rcroman20@gmail\\.com$')
          )
        );
    }

    function adminAccessPath() {
      return /databases/$(database)/documents/adminConfig/access;
    }

    function adminPermissionsPath() {
      return /databases/$(database)/documents/adminConfig/delegatedPermissions;
    }

    function adminAccessDocExists() {
      return exists(adminAccessPath());
    }

    function adminPermissionsDocExists() {
      return exists(adminPermissionsPath());
    }

    function adminAccessDoc() {
      return get(adminAccessPath());
    }

    function adminPermissionsDoc() {
      return get(adminPermissionsPath());
    }

    function isDelegatedAdminUid() {
      return signedIn()
        && adminAccessDocExists()
        && request.auth.uid in adminAccessDoc().data.delegatedAdminUserIds;
    }

    function isAdminAccessUser() {
      return isOwnerAdminEmail() || isDelegatedAdminUid();
    }

    function canReadAdminAcademicData() {
      return isAdminAccessUser();
    }

    function canManageTeacherApprovals() {
      return isOwnerAdminEmail()
        || (
          isDelegatedAdminUid()
          && adminPermissionsDocExists()
          && adminPermissionsDoc().data.manageTeacherApprovals == true
        );
    }

    function canManageDeletions() {
      return isOwnerAdminEmail()
        || (
          isDelegatedAdminUid()
          && adminPermissionsDocExists()
          && adminPermissionsDoc().data.manageDeletions == true
        );
    }

    function canManageInbox() {
      return isOwnerAdminEmail()
        || (
          isDelegatedAdminUid()
          && adminPermissionsDocExists()
          && adminPermissionsDoc().data.manageInbox == true
        );
    }

    function canManageSettings() {
      return isOwnerAdminEmail()
        || (
          isDelegatedAdminUid()
          && adminPermissionsDocExists()
          && adminPermissionsDoc().data.manageSettings == true
        );
    }

    function canManageBilling() {
      return isOwnerAdminEmail()
        || (
          isDelegatedAdminUid()
          && adminPermissionsDocExists()
          && adminPermissionsDoc().data.manageBilling == true
        );
    }

    function canManageInstitutions() {
      return isOwnerAdminEmail()
        || (
          isDelegatedAdminUid()
          && adminPermissionsDocExists()
          && adminPermissionsDoc().data.manageInstitutions == true
        );
    }

    function canManageUsersDirectory() {
      return isOwnerAdminEmail()
        || (
          isDelegatedAdminUid()
          && adminPermissionsDocExists()
          && adminPermissionsDoc().data.manageUsersDirectory == true
        );
    }

    function canExportReports() {
      return isOwnerAdminEmail()
        || (
          isDelegatedAdminUid()
          && adminPermissionsDocExists()
          && adminPermissionsDoc().data.exportReports == true
        );
    }

    function canManageBackups() {
      return isOwnerAdminEmail()
        || (
          isDelegatedAdminUid()
          && adminPermissionsDocExists()
          && adminPermissionsDoc().data.manageBackups == true
        );
    }

    function hasCourseId(data) {
      return ("courseId" in data)
        && data.courseId is string
        && data.courseId.size() > 0;
    }

    function hasTeacherId(data) {
      return ("teacherId" in data)
        && data.teacherId is string
        && data.teacherId.size() > 0;
    }

    function hasInstitutionId(data) {
      return ("institutionId" in data)
        && data.institutionId is string
        && data.institutionId.size() > 0;
    }

    function hasStudentId(data) {
      return ("studentId" in data)
        && data.studentId is string
        && data.studentId.size() > 0;
    }

    function hasGradedBy(data) {
      return ("gradedBy" in data)
        && data.gradedBy is string
        && data.gradedBy.size() > 0;
    }

    function canReadCourseBound(data) {
      return signedIn()
        && (
          canReadAdminAcademicData()
          || (hasCourseId(data) && canAccessCourse(data.courseId))
        );
    }

    function canWriteCourseBound(data) {
      return signedIn()
        && (
          isOwnerAdminEmail()
          || (hasCourseId(data) && isCourseTeacher(data.courseId))
        );
    }

    function unitPath(unitId) {
      return /databases/$(database)/documents/unidades/$(unitId);
    }

    function periodPath(periodId) {
      return /databases/$(database)/documents/periods/$(periodId);
    }

    function weekPath(weekId) {
      return /databases/$(database)/documents/semanas/$(weekId);
    }

    function structuredWeekPath(weekId) {
      return /databases/$(database)/documents/weeks/$(weekId);
    }

    function hasUnitId(data) {
      return ("unitId" in data)
        && data.unitId is string
        && data.unitId.size() > 0;
    }

    function hasPeriodId(data) {
      return ("periodId" in data)
        && data.periodId is string
        && data.periodId.size() > 0;
    }

    function hasWeekId(data) {
      return ("weekId" in data)
        && data.weekId is string
        && data.weekId.size() > 0;
    }

    function weekCourseIdFromData(data) {
      return hasCourseId(data)
        ? data.courseId
        : (
            hasUnitId(data)
            && exists(unitPath(data.unitId))
            && hasCourseId(get(unitPath(data.unitId)).data)
              ? get(unitPath(data.unitId)).data.courseId
              : null
          );
    }

    function slideCourseIdFromData(data) {
      return hasCourseId(data)
        ? data.courseId
        : (
            hasWeekId(data)
            && exists(weekPath(data.weekId))
              ? (
                  hasCourseId(get(weekPath(data.weekId)).data)
                    ? get(weekPath(data.weekId)).data.courseId
                    : (
                        hasUnitId(get(weekPath(data.weekId)).data)
                        && exists(unitPath(get(weekPath(data.weekId)).data.unitId))
                        && hasCourseId(get(unitPath(get(weekPath(data.weekId)).data.unitId)).data)
                          ? get(unitPath(get(weekPath(data.weekId)).data.unitId)).data.courseId
                          : null
                      )
                )
              : null
          );
    }

    function canReadWeekBound(data) {
      return signedIn()
        && (
          canReadAdminAcademicData()
          || (
            weekCourseIdFromData(data) is string
            && weekCourseIdFromData(data).size() > 0
            && canAccessCourse(weekCourseIdFromData(data))
          )
        );
    }

    function canWriteWeekBound(data) {
      return signedIn()
        && (
          isOwnerAdminEmail()
          || (
            weekCourseIdFromData(data) is string
            && weekCourseIdFromData(data).size() > 0
            && isCourseTeacher(weekCourseIdFromData(data))
          )
        );
    }

    function canReadSlideBound(data) {
      return signedIn()
        && (
          canReadAdminAcademicData()
          || (
            slideCourseIdFromData(data) is string
            && slideCourseIdFromData(data).size() > 0
            && canAccessCourse(slideCourseIdFromData(data))
          )
        );
    }

    function canWriteSlideBound(data) {
      return signedIn()
        && (
          isOwnerAdminEmail()
          || (
            slideCourseIdFromData(data) is string
            && slideCourseIdFromData(data).size() > 0
            && isCourseTeacher(slideCourseIdFromData(data))
          )
        );
    }

    function fileCourseIdFromData(data) {
      return hasCourseId(data)
        ? data.courseId
        : (
            hasPeriodId(data)
            && exists(periodPath(data.periodId))
            && hasCourseId(get(periodPath(data.periodId)).data)
              ? get(periodPath(data.periodId)).data.courseId
              : (
                  hasWeekId(data)
                  && exists(structuredWeekPath(data.weekId))
                  && hasCourseId(get(structuredWeekPath(data.weekId)).data)
                    ? get(structuredWeekPath(data.weekId)).data.courseId
                    : (
                        hasWeekId(data)
                        && exists(weekPath(data.weekId))
                          ? (
                              hasCourseId(get(weekPath(data.weekId)).data)
                                ? get(weekPath(data.weekId)).data.courseId
                                : (
                                    hasUnitId(get(weekPath(data.weekId)).data)
                                    && exists(unitPath(get(weekPath(data.weekId)).data.unitId))
                                    && hasCourseId(get(unitPath(get(weekPath(data.weekId)).data.unitId)).data)
                                      ? get(unitPath(get(weekPath(data.weekId)).data.unitId)).data.courseId
                                      : null
                                  )
                            )
                          : null
                      )
                )
          );
    }

    function canReadCourseFileBound(data) {
      return signedIn()
        && (
          canReadAdminAcademicData()
          || (
            fileCourseIdFromData(data) is string
            && fileCourseIdFromData(data).size() > 0
            && canAccessCourse(fileCourseIdFromData(data))
          )
        );
    }

    function canReadTeacherOrCourseBound(data) {
      return signedIn()
        && (
          canReadAdminAcademicData()
          || (hasTeacherId(data) && data.teacherId == request.auth.uid)
          || (hasCourseId(data) && canAccessCourse(data.courseId))
        );
    }

    function canWriteTeacherOrCourseBound(data) {
      return signedIn()
        && (
          isOwnerAdminEmail()
          || (hasTeacherId(data) && data.teacherId == request.auth.uid)
          || (hasCourseId(data) && isCourseTeacher(data.courseId))
        );
    }

    function canReadGradeLike(data) {
      return signedIn()
        && (
          canReadAdminAcademicData()
          || (hasStudentId(data) && data.studentId == request.auth.uid)
          || (hasGradedBy(data) && data.gradedBy == request.auth.uid)
          || (hasCourseId(data) && canAccessCourse(data.courseId))
        );
    }

    function canWriteGradeLike(data) {
      return signedIn()
        && (
          isOwnerAdminEmail()
          || (hasGradedBy(data) && data.gradedBy == request.auth.uid)
          || (hasCourseId(data) && isCourseTeacher(data.courseId))
        );
    }

    // Función específica para permitir transferencia de curso (profesor actual o admin)
    function canTransferCourse(courseId) {
      return signedIn()
        && courseExists(courseId)
        && (
          isOwnerAdminEmail()  // Admin siempre puede
          || (
            courseDoc(courseId).data.teacherId == request.auth.uid  // Profesor actual
            && courseDoc(courseId).data.code != 'TEACHER-ONBOARDING-001'  // No es curso obligatorio
          )
        );
    }

    // Función para verificar si es una operación de transferencia en curso
    function isCourseTransfer(resourceData, requestData) {
      return requestData.diff(resourceData).affectedKeys().hasOnly([
        'teacherId', 'teacherName', 'updatedAt'
      ])
      && requestData.teacherId is string
      && requestData.teacherName is string;
    }

    // Función para verificar si es una operación de backfill de contenido
    function isContentBackfill(resourceData, requestData) {
      return requestData.diff(resourceData).affectedKeys().hasOnly(['courseId', 'updatedAt'])
      && requestData.courseId is string
      && requestData.courseId.size() > 0;
    }

    match /adminConfig/{configId} {
      allow read: if (
          configId == "platformSettings"
        )
        || (
          configId == "access"
          && signedIn()
          && (
            isOwnerAdminEmail()
            || (
              resource.data.delegatedAdminUserIds is list
              && request.auth.uid in resource.data.delegatedAdminUserIds
            )
          )
        )
        || (
          configId == "delegatedPermissions"
          && isAdminAccessUser()
        );
      allow create, update, delete: if (
          configId == "platformSettings"
          && canManageSettings()
        )
        || isOwnerAdminEmail();
    }

    match /publicDirectory/{docId} {
      allow read: if docId == "institutions";
      allow create, update: if signedIn() && docId == "institutions";
      allow delete: if isOwnerAdminEmail() && docId == "institutions";
    }

    match /instituciones/{institutionId} {
      allow read: if canManageInstitutionById(institutionId);
      allow create: if signedIn()
        && (
          isOwnerAdminEmail()
          || (
            userHasInstitutionPrivileges(request.auth.uid)
            && institutionId == request.auth.uid
          )
        );
      allow update, delete: if canManageInstitutionById(institutionId);
    }

    match /usuarios/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && (
          request.resource.data.role in ['docente', 'estudiante', 'institucion']
          || (isOwnerAdminEmail() && request.resource.data.role == 'admin')
        )
        || (
          (canManageTeacherApprovals() || canManageInstitutions() || canManageUsersDirectory())
          && request.resource.data.role in ['docente', 'estudiante', 'admin', 'institucion']
        )
        || (
          canManageInstitutionById(currentInstitutionId())
          && request.resource.data.keys().hasOnly([
            "id",
            "email",
            "name",
            "role",
            "requestedRole",
            "teacherApprovalStatus",
            "teacherInstitutionName",
            "institutionId",
            "institutionName",
            "institution",
            "institutionManaged",
            "updatedAt"
          ])
          && request.resource.data.role in ['docente', 'estudiante']
          && request.resource.data.institutionId == currentInstitutionId()
          && request.resource.data.email is string
          && request.resource.data.name is string
          && (
            !("requestedRole" in request.resource.data)
            || request.resource.data.requestedRole in ['docente', 'estudiante']
          )
          && (
            !("teacherApprovalStatus" in request.resource.data)
            || request.resource.data.teacherApprovalStatus in ['pending', 'approved', 'rejected']
          )
        );
      allow update: if (
          isOwner(userId)
          && request.resource.data.role is string
          && (
            (
              "role" in resource.data
              && request.resource.data.role == resource.data.role
            )
            || (
              !("role" in resource.data)
              && request.resource.data.role in ['docente', 'estudiante', 'teacher', 'student']
            )
          )
        )
        || (
          (
            canManageTeacherApprovals()
            || canManageBilling()
            || canManageInstitutions()
            || canManageUsersDirectory()
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "role",
            "requestedRole",
            "teacherApprovalStatus",
            "teacherInstitutionName",
            "institutionName",
            "institution",
            "teacherApprovedAt",
            "teacherApprovedBy",
            "teacherRejectedAt",
            "teacherRejectedBy",
            "teacherRejectionReason",
            "institutionId",
            "teacherPlanId",
            "teacherPlanName",
            "teacherPlanPriceCop",
            "teacherPlanDurationMonths",
            "teacherPlanDurationLabel",
            "teacherPlanCourseLimit",
            "teacherPlanStudentLimit",
            "teacherPlanAnalyticsLabel",
            "teacherPlanSupportLabel",
            "teacherPlanAssignedAt",
            "teacherPlanExpiresAt",
            "teacherPlanStatus",
            "teacherPaymentInstructions",
            "teacherPaymentRequestedAt",
            "teacherPaymentRequestedBy",
            "institutionName",
            "institution",
            "teacherInstitutionName",
            "institutionRole",
            "institutionManaged",
            "institutionApprovalStatus",
            "institutionPlanStatus",
            "institutionPlanName",
            "institutionRequestedPlanId",
            "institutionRequestedCourseLimit",
            "institutionRequestedStudentLimit",
            "institutionRequestedTeacherLimit",
            "institutionRequestedPriceCop",
            "institutionRequestedMonthlyEquivalentCop",
            "institutionPlanPriceCop",
            "institutionPlanMonthlyEquivalentCop",
            "institutionCourseLimit",
            "institutionStudentLimit",
            "institutionTeacherLimit",
            "institutionPaymentMethod",
            "institutionPlanNotes",
            "institutionPaymentInstructions",
            "institutionPaymentRequestedAt",
            "institutionPaymentRequestedBy",
            "updatedAt"
          ])
          && (
            request.resource.data.role in ['docente', 'estudiante', 'institucion']
            || (isOwner(userId) && request.resource.data.role == 'admin')
          )
          && (
            !("requestedRole" in request.resource.data)
            || request.resource.data.requestedRole in ['docente', 'estudiante']
            || (isOwner(userId) && request.resource.data.requestedRole == 'admin')
          )
          && (
            !("teacherApprovalStatus" in request.resource.data)
            || request.resource.data.teacherApprovalStatus in ['pending', 'approved', 'rejected']
          )
          && (
            !("teacherRejectionReason" in request.resource.data)
            || request.resource.data.teacherRejectionReason is string
            || request.resource.data.teacherRejectionReason == null
          )
        )
        || (
          canManageInstitutionById(currentInstitutionId())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "role",
            "requestedRole",
            "teacherApprovalStatus",
            "institutionId",
            "institutionName",
            "institution",
            "teacherInstitutionName",
            "institutionManaged",
            "updatedAt"
          ])
          && request.resource.data.institutionId == currentInstitutionId()
          && (
            !("institutionId" in resource.data)
            || resource.data.institutionId == currentInstitutionId()
          )
          && request.resource.data.role in ['docente', 'estudiante']
        );
      allow delete: if isOwner(userId)
        || canManageDeletions()
        || (isCurrentUserTeacher() && targetUserIsStudent(userId));
    }

    // Notifications per user
    match /usuarios/{userId}/notifications/{notificationId} {
      allow read: if isOwner(userId);

      allow create: if signedIn()
        && (userDocExists(userId) || studentDocExists(userId))
        && request.resource.data.keys().hasOnly([
          "title", "message", "type", "link", "read", "createdAt", "expiresAt", "senderId"
        ])
        && request.resource.data.senderId is string
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.type in ["info", "success", "warning"]
        && request.resource.data.read is bool
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt >= request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, "d")
        && (!("link" in request.resource.data) || request.resource.data.link is string);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        && request.resource.data.read is bool;

      allow delete: if isOwner(userId) || canManageDeletions();
    }

    // Course backup snapshots (teacher-owned)
    match /courseBackups/{backupId} {
      allow read: if canReadAdminAcademicData()
        || (signedIn() && resource.data.teacherId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "teacherId", "teacherName", "courseId", "courseCode", "courseName", "exportedAt", "payload", "createdAt"
        ])
        && request.resource.data.teacherId is string
        && request.resource.data.teacherName is string
        && request.resource.data.courseId is string
        && request.resource.data.courseCode is string
        && request.resource.data.courseName is string
        && request.resource.data.exportedAt is string
        && request.resource.data.createdAt is timestamp;

      allow delete: if canManageBackups()
        || (signedIn() && resource.data.teacherId == request.auth.uid);
      allow update: if false;
    }

    match /cursos/{courseId} {
      allow read: if signedIn();
      
      // Creación de curso
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow create: if signedIn()
        && hasInstitutionId(request.resource.data)
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByInstitutionId is string
        && request.resource.data.createdByInstitutionId == request.resource.data.institutionId
        && canManageInstitutionById(request.resource.data.institutionId)
        && (
          !hasTeacherId(request.resource.data)
          || teacherBelongsToInstitution(
            request.resource.data.teacherId,
            request.resource.data.institutionId
          )
        );
      allow create: if signedIn()
        && hasInstitutionId(request.resource.data)
        && canManageInstitutionById(request.resource.data.institutionId)
        && (
          !hasTeacherId(request.resource.data)
          || teacherBelongsToInstitution(request.resource.data.teacherId, request.resource.data.institutionId)
        );

      // Actualización regular del curso (profesor actual)
      allow update: if signedIn() && (
        resource.data.teacherId == request.auth.uid
        || isOwnerAdminEmail()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudents'])
          && (
            (
              request.resource.data.enrolledStudents.size() == resource.data.enrolledStudents.size() + 1
              && request.resource.data.enrolledStudents.hasAll(resource.data.enrolledStudents)
              && request.resource.data.enrolledStudents.hasAll([request.auth.uid])
            )
            || (
              request.resource.data.enrolledStudents.size() + 1 == resource.data.enrolledStudents.size()
              && resource.data.enrolledStudents.hasAll(request.resource.data.enrolledStudents)
              && resource.data.enrolledStudents.hasAll([request.auth.uid])
            )
          )
        )
      );
      allow update: if canManageInstitutionCourse(courseId)
        && request.resource.data.institutionId == resource.data.institutionId
        && (
          !hasTeacherId(request.resource.data)
          || teacherBelongsToInstitution(request.resource.data.teacherId, request.resource.data.institutionId)
        );

      // Regla especial para TRANSFERENCIA de curso - SOLO campos específicos
      allow update: if canTransferCourse(courseId)
        && isCourseTransfer(resource.data, request.resource.data);

      allow delete: if signedIn() && (
        resource.data.teacherId == request.auth.uid
        || isOwnerAdminEmail()
        || canManageInstitutionCourse(courseId)
      );
    }

    match /estudiantes/{studentId} {
      allow read: if signedIn();
      allow create: if isOwner(studentId)
        && request.resource.data.role in ['docente', 'estudiante', 'institucion'];
      allow create: if (
          canManageTeacherApprovals()
          || canManageInstitutions()
          || canManageUsersDirectory()
        )
        && request.resource.data.role in ['docente', 'estudiante', 'admin', 'institucion'];
      allow create: if canManageInstitutionById(currentInstitutionId())
        && request.resource.data.keys().hasOnly([
          "id",
          "email",
          "name",
          "role",
          "requestedRole",
          "teacherApprovalStatus",
          "teacherInstitutionName",
          "institutionId",
          "institutionName",
          "institution",
          "institutionManaged",
          "updatedAt"
        ])
        && request.resource.data.role in ['docente', 'estudiante']
        && request.resource.data.institutionId == currentInstitutionId()
        && request.resource.data.email is string
        && request.resource.data.name is string
        && (
          !("requestedRole" in request.resource.data)
          || request.resource.data.requestedRole in ['docente', 'estudiante']
        )
        && (
          !("teacherApprovalStatus" in request.resource.data)
          || request.resource.data.teacherApprovalStatus in ['pending', 'approved', 'rejected']
        );
      allow update: if signedIn() && (
        isOwner(studentId)
        || (isCurrentUserTeacher() && targetUserIsStudent(studentId))
        || canManageTeacherApprovals()
        || canManageBilling()
        || canManageInstitutions()
        || canManageUsersDirectory()
        || (
          canManageInstitutionById(currentInstitutionId())
          && request.resource.data.institutionId == currentInstitutionId()
          && (
            !("institutionId" in resource.data)
            || resource.data.institutionId == currentInstitutionId()
          )
        )
      );
      allow delete: if signedIn() && (
        request.auth.uid == studentId
        || isCurrentUserTeacher()
        || canManageDeletions()
      );
    }

    match /gradeSheets/{sheetId} {
      allow read: if canReadTeacherOrCourseBound(resource.data);
      allow create: if canWriteTeacherOrCourseBound(request.resource.data);
      
      // Actualización normal
      allow update, delete: if canWriteTeacherOrCourseBound(resource.data);
      
      // REGLA ESPECIAL PARA TRANSFERENCIA - permitir actualización de teacherId durante transferencia
      allow update: if canTransferCourse(resource.data.courseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherId', 'teacherName', 'updatedAt'])
        && request.resource.data.teacherId is string
        && request.resource.data.teacherName is string;
      allow update: if canManageInstitutionCourse(resource.data.courseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherId', 'teacherName', 'updatedAt'])
        && request.resource.data.teacherId is string
        && request.resource.data.teacherName is string;
    }

    match /unidades/{unitId} {
      allow read: if canReadCourseBound(resource.data);
      allow create: if canWriteCourseBound(request.resource.data);
      allow update, delete: if canWriteCourseBound(resource.data);
    }

    match /semanas/{weekId} {
      allow read: if canReadWeekBound(resource.data);
      allow create: if canWriteWeekBound(request.resource.data);
      allow update, delete: if canWriteWeekBound(resource.data)
        || canWriteWeekBound(request.resource.data);
    }

    match /diapositivas/{slideId} {
      allow read: if canReadSlideBound(resource.data);
      allow create: if canWriteSlideBound(request.resource.data);
      allow update, delete: if canWriteSlideBound(resource.data)
        || canWriteSlideBound(request.resource.data);
    }

    match /evaluaciones/{assessmentId} {
      allow read: if canReadCourseBound(resource.data);
      allow create: if canWriteCourseBound(request.resource.data);
      
      // Actualización normal
      allow update, delete: if canWriteCourseBound(resource.data);
      
      // REGLA ESPECIAL PARA TRANSFERENCIA
      allow update: if canTransferCourse(resource.data.courseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherId', 'teacherName', 'updatedAt'])
        && request.resource.data.teacherId is string
        && request.resource.data.teacherName is string;
      allow update: if canManageInstitutionCourse(resource.data.courseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherId', 'teacherName', 'updatedAt'])
        && request.resource.data.teacherId is string
        && request.resource.data.teacherName is string;
    }

    match /assessments/{assessmentId} {
      allow read: if canReadCourseBound(resource.data);
      allow create: if canWriteCourseBound(request.resource.data);
      
      // Actualización normal
      allow update, delete: if canWriteCourseBound(resource.data);
      
      // REGLA ESPECIAL PARA TRANSFERENCIA
      allow update: if canTransferCourse(resource.data.courseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherId', 'teacherName', 'updatedAt'])
        && request.resource.data.teacherId is string
        && request.resource.data.teacherName is string;
      allow update: if canManageInstitutionCourse(resource.data.courseId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherId', 'teacherName', 'updatedAt'])
        && request.resource.data.teacherId is string
        && request.resource.data.teacherName is string;
    }

    match /assessmentForumComments/{commentId} {
      allow read: if signedIn() && (
        !("courseId" in resource.data) || canAccessCourse(resource.data.courseId)
      );

      allow create: if signedIn()
        && ("courseId" in request.resource.data)
        && canAccessCourse(request.resource.data.courseId)
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isCourseTeacher(resource.data.courseId) ||
        (
          canAccessCourse(resource.data.courseId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["likedBy", "dislikedBy"])
          && request.resource.data.assessmentId == resource.data.assessmentId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.content == resource.data.content
        )
      );

      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isCourseTeacher(resource.data.courseId)
      );
    }

    match /notas/{gradeId} {
      allow read: if canReadGradeLike(resource.data);
      allow create: if canWriteGradeLike(request.resource.data);
      allow update, delete: if canWriteGradeLike(resource.data);
    }

    match /grades/{gradeId} {
      allow read: if canReadGradeLike(resource.data);
      allow create: if canWriteGradeLike(request.resource.data);
      allow update, delete: if canWriteGradeLike(resource.data);
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (
        canReadAdminAcademicData()
        || (hasStudentId(resource.data) && resource.data.studentId == request.auth.uid)
        || (hasGradedBy(resource.data) && resource.data.gradedBy == request.auth.uid)
        || (hasCourseId(resource.data) && canAccessCourse(resource.data.courseId))
      );
      allow create: if signedIn() && (
        isOwnerAdminEmail()
        || (
          hasCourseId(request.resource.data)
          && hasStudentId(request.resource.data)
          && request.resource.data.studentId == request.auth.uid
          && isCourseStudent(request.resource.data.courseId)
        )
        || (hasCourseId(request.resource.data) && isCourseTeacher(request.resource.data.courseId))
      );
      allow update, delete: if signedIn() && (
        isOwnerAdminEmail()
        || (hasStudentId(resource.data) && resource.data.studentId == request.auth.uid)
        || (hasCourseId(resource.data) && isCourseTeacher(resource.data.courseId))
      );
    }

    match /periods/{periodId} {
      allow read: if canReadCourseBound(resource.data);
      allow create: if canWriteCourseBound(request.resource.data);
      allow update, delete: if canWriteCourseBound(resource.data);
      
      // REGLA ESPECIAL PARA BACKFILL DE CONTENIDO
      allow update: if canTransferCourse(request.resource.data.courseId)
        && isContentBackfill(resource.data, request.resource.data);
    }

    match /weeks/{weekId} {
      allow read: if canReadCourseBound(resource.data);
      allow create: if canWriteCourseBound(request.resource.data);
      allow update, delete: if canWriteCourseBound(resource.data);
      
      // REGLA ESPECIAL PARA BACKFILL DE CONTENIDO
      allow update: if canTransferCourse(request.resource.data.courseId)
        && isContentBackfill(resource.data, request.resource.data);
    }

    match /course_files/{fileId} {
      allow read: if canReadCourseFileBound(resource.data);
      allow create: if canWriteCourseBound(request.resource.data);
      allow update, delete: if canWriteCourseBound(resource.data);
      
      // REGLA ESPECIAL PARA BACKFILL DE CONTENIDO
      allow update: if canTransferCourse(request.resource.data.courseId)
        && isContentBackfill(resource.data, request.resource.data);
    }

    match /course_file/{fileId} {
      allow read: if canReadCourseFileBound(resource.data);
      allow create: if canWriteCourseBound(request.resource.data);
      allow update, delete: if canWriteCourseBound(resource.data);
      
      // REGLA ESPECIAL PARA BACKFILL DE CONTENIDO
      allow update: if canTransferCourse(request.resource.data.courseId)
        && isContentBackfill(resource.data, request.resource.data);
    }

    // Question bank
    match /exerciseQuestions/{questionId} {
      allow read: if canAccessCourse(resource.data.courseId) || isCurrentUserTeacher();

      allow create: if signedIn()
        && isCourseTeacher(request.resource.data.courseId)
        && request.resource.data.keys().hasOnly([
          "courseId", "theme", "question", "options", "correctOptionIndex", "isPublished", "createdBy", "createdAt"
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.theme is string
        && request.resource.data.theme.size() > 0
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.options is list
        && request.resource.data.options.size() == 4
        && request.resource.data.options[0] is string
        && request.resource.data.options[1] is string
        && request.resource.data.options[2] is string
        && request.resource.data.options[3] is string
        && request.resource.data.correctOptionIndex is int
        && request.resource.data.correctOptionIndex >= 0
        && request.resource.data.correctOptionIndex < 4
        && request.resource.data.isPublished is bool;

      allow update: if signedIn()
        && isCourseTeacher(resource.data.courseId)
        && request.resource.data.keys().hasOnly([
          "courseId", "theme", "question", "options", "correctOptionIndex", "isPublished", "createdBy", "createdAt"
        ])
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isCourseTeacher(resource.data.courseId);
    }

    // Theme -> grade sheet link
    match /exerciseThemeLinks/{linkId} {
      allow read: if canAccessCourse(resource.data.courseId);

      allow create: if signedIn()
        && isCourseTeacher(request.resource.data.courseId)
        && request.resource.data.keys().hasOnly([
          "courseId", "theme", "gradeSheetId", "updatedBy", "updatedAt"
        ])
        && request.resource.data.theme is string
        && request.resource.data.theme.size() > 0
        && request.resource.data.gradeSheetId is string
        && request.resource.data.gradeSheetId.size() > 0
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if signedIn()
        && isCourseTeacher(resource.data.courseId)
        && request.resource.data.keys().hasOnly([
          "courseId", "theme", "gradeSheetId", "updatedBy", "updatedAt"
        ])
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.theme == resource.data.theme
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if signedIn() && isCourseTeacher(resource.data.courseId);
    }

    // Cross-course shared quiz templates (teacher-owned)
    match /quizBankTemplates/{templateId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "ownerId", "ownerName", "ownerEmail", "sourceCourseId", "sourceCourseCode", "sourceCourseName",
          "theme", "normalizedTheme", "questionCount", "questions", "createdAt", "updatedAt"
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerEmail is string
        && request.resource.data.sourceCourseId is string
        && request.resource.data.sourceCourseCode is string
        && request.resource.data.sourceCourseName is string
        && request.resource.data.theme is string
        && request.resource.data.theme.size() > 0
        && request.resource.data.normalizedTheme is string
        && request.resource.data.normalizedTheme.size() > 0
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount > 0
        && request.resource.data.questions is list
        && request.resource.data.questions.size() == request.resource.data.questionCount
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "ownerId", "ownerName", "ownerEmail", "sourceCourseId", "sourceCourseCode", "sourceCourseName",
          "theme", "normalizedTheme", "questionCount", "questions", "createdAt", "updatedAt"
        ])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerName is string
        && request.resource.data.ownerEmail is string
        && request.resource.data.sourceCourseId is string
        && request.resource.data.sourceCourseCode is string
        && request.resource.data.sourceCourseName is string
        && request.resource.data.theme is string
        && request.resource.data.theme.size() > 0
        && request.resource.data.normalizedTheme is string
        && request.resource.data.normalizedTheme.size() > 0
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount > 0
        && request.resource.data.questions is list
        && request.resource.data.questions.size() == request.resource.data.questionCount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Quiz attempts
    match /quizAttempts/{attemptId} {
      allow read: if canAccessCourse(resource.data.courseId);

      allow create: if signedIn()
        && isCourseStudent(request.resource.data.courseId)
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "courseId", "theme", "studentId", "total", "correct", "percentage", "answers", "createdAt"
        ])
        && request.resource.data.theme is string
        && request.resource.data.theme.size() > 0
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.percentage is int
        && request.resource.data.percentage >= 0
        && request.resource.data.percentage <= 100
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == request.resource.data.total;

      allow update: if false;
      allow delete: if isCourseTeacher(resource.data.courseId);
    }

    match /accountDeletionRequests/{requestId} {
      allow read: if isOwner(requestId) || canManageDeletions();
      allow create: if isOwner(requestId) || canManageDeletions();
      allow update: if isOwner(requestId) || canManageDeletions();
      allow delete: if canManageDeletions();
    }

    match /deletedAccounts/{userId} {
      allow read: if isOwner(userId) || canManageDeletions();
      allow create, update, delete: if canManageDeletions();
    }

    match /pricingContactRequests/{requestId} {
      allow read: if canManageInbox() || canManageBilling();

      allow create: if request.resource.data.keys().hasOnly([
          "name",
          "email",
          "institutionName",
          "role",
          "desiredCourses",
          "desiredStudents",
          "interestedPlanId",
          "message",
          "status",
          "source",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 190
        && request.resource.data.institutionName is string
        && request.resource.data.institutionName.size() >= 2
        && request.resource.data.institutionName.size() <= 190
        && request.resource.data.role in ["teacher", "organization", "admin_team"]
        && request.resource.data.desiredCourses is int
        && request.resource.data.desiredCourses >= 0
        && request.resource.data.desiredCourses <= 5000
        && request.resource.data.desiredStudents is int
        && request.resource.data.desiredStudents >= 0
        && request.resource.data.desiredStudents <= 250000
        && (
          request.resource.data.interestedPlanId == null
          || request.resource.data.interestedPlanId is string
        )
        && (
          request.resource.data.message == null
          || request.resource.data.message is string
        )
        && request.resource.data.status == "new"
        && request.resource.data.source == "landing_estimator"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if canManageInbox() || canManageBilling();
    }

    match /contactMessages/{requestId} {
      allow read: if canManageInbox();

      allow create: if request.resource.data.keys().hasOnly([
          "name",
          "email",
          "phone",
          "institution",
          "role",
          "subject",
          "message",
          "status",
          "source",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 190
        && (
          request.resource.data.phone == null
          || request.resource.data.phone is string
        )
        && (
          request.resource.data.institution == null
          || request.resource.data.institution is string
        )
        && request.resource.data.role in ["student", "teacher", "admin", "organization", "other"]
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 4
        && request.resource.data.subject.size() <= 190
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == "new"
        && request.resource.data.source == "contact_page"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;

      allow update, delete: if canManageInbox();
    }

    match /adminAuditLog/{entryId} {
      allow read: if canExportReports();
      allow create: if isAdminAccessUser();
      allow update, delete: if isOwnerAdminEmail();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
